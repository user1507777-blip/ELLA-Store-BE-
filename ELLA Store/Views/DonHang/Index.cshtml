@model IEnumerable<ELLA_Store.Models.Order>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Quản lý đơn hàng";
}
@{ var dem = (Dictionary<string, int>)ViewBag.DemTheoTrangThai; }
<div class="container-custom">
    <h2>Quản Lý Đơn Hàng</h2>
    @if (TempData["ThongBao"] != null)
    {<p class="success-msg">@TempData["ThongBao"]</p>}
    @if (TempData["Loi"] != null)
    {<p class="error-msg">@TempData["Loi"]</p>}

    <div class="admin-stats">
        @foreach (var s in ELLA_Store.Models.OrderStatus.All)
        {
            <div class="order-box"><strong>@dem[s]</strong><br>@s</div>
        }
        <div class="order-box"><strong style="color:#0f766e;">@(((decimal)ViewBag.DoanhThu).ToString("#,##0"))đ</strong><br>Doanh thu (đơn hoàn thành)</div>
    </div>

    <form method="get" action="/DonHang" class="admin-toolbar">
        <input type="text" name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm theo mã đơn, tên người nhận hoặc SĐT...">
        <select name="trangThai" class="form-control" style="max-width:200px;">
            <option value="">Tất cả trạng thái</option>
            @foreach (var s in ELLA_Store.Models.OrderStatus.All)
            {
                <option value="@s" @(ViewBag.TrangThai == s ? "selected" : "")>@s</option>
            }
        </select>
        <button type="submit" class="btn">Lọc</button>
    </form>

    @* ===== Voucher ===== *@
    @if (Session["VoucherCode"] != null)
    {
        <div class="order-box" style="margin:15px 0;">
            Đang áp dụng mã <strong>@Session["VoucherCode"]</strong>
            (giảm @(((decimal)Session["DiscountAmount"]).ToString("#,##0"))đ)
            @using (Html.BeginForm("HuyVoucher", "DonHang", FormMethod.Post, new { @class = "admin-inline" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn">Bỏ mã</button>
            }
        </div>
    }
    else
    {
        using (Html.BeginForm("ApDungVoucher", "DonHang", FormMethod.Post, new { @class = "admin-toolbar" }))
        {
            @Html.AntiForgeryToken()
            <input type="text" name="voucherCode" class="form-control" placeholder="Nhập mã voucher..." required style="max-width:250px;" />
            <button type="submit" class="btn">Áp dụng Voucher</button>
        }
    }

    @Html.Partial("_DanhSachDon", Model.ToList())
</div>
