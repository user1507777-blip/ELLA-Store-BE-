@model ELLA_Store.Models.Category
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Xóa danh mục";
}

<div style="display: flex; justify-content: center; align-items: center; padding: 40px 20px;">
    <div style="width: 100%; max-width: 600px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 36px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);">

        <!-- Header -->
        <h2 style="font-size: 24px; font-weight: 800; color: #0f172a; margin: 0 0 6px 0;">Xóa danh mục</h2>
        <p style="font-size: 14px; color: #64748b; margin: 0 0 24px 0;">Hành động này sẽ xóa vĩnh viễn dữ liệu và không thể hoàn tác.</p>

        <!-- Khung thông tin -->
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; padding: 24px; margin-bottom: 24px;">

            <div style="margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px dashed #e2e8f0;">
                <div style="font-size: 12px; font-weight: 800; color: #475569; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 4px;">Tên danh mục</div>
                <div style="font-size: 16px; font-weight: 700; color: #0f172a;">@Model.CategoryName</div>
            </div>

            <div style="margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px dashed #e2e8f0;">
                <div style="font-size: 12px; font-weight: 800; color: #475569; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 4px;">Mô tả</div>
                <div style="font-size: 15px; font-weight: 400; color: #334155;">@(string.IsNullOrEmpty(Model.Description) ? "Không có mô tả" : Model.Description)</div>
            </div>

            <div>
                <div style="font-size: 12px; font-weight: 800; color: #475569; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 4px;">Số hàng hóa trực thuộc</div>
                <div style="font-size: 15px; font-weight: 700; color: @((int)ViewBag.SoSanPham > 0 ? "#dc2626" : "#16a34a");">
                    @ViewBag.SoSanPham sản phẩm
                </div>
            </div>

        </div>

        @if ((int)ViewBag.SoSanPham > 0)
        {
            <div style="font-size: 14px; color: #dc2626; font-weight: 600; background: #fef2f2; padding: 14px 18px; border-radius: 12px; border-left: 4px solid #dc2626; margin-bottom: 24px;">
                Không thể xóa: Vẫn còn @ViewBag.SoSanPham hàng hóa thuộc danh mục này. Vui lòng chuyển hoặc xóa các sản phẩm đó trước.
            </div>
            <div style="text-align: center;">
                <a href="/DanhMuc" style="display: inline-flex; align-items: center; justify-content: center; padding: 12px 24px; background: #f1f5f9; color: #334155; border-radius: 12px; font-size: 15px; font-weight: 600; text-decoration: none;">&larr; Quay lại danh sách</a>
            </div>
        }
        else
        {
            <div style="font-size: 14px; font-weight: 600; color: #0f172a; margin-bottom: 16px;">
                Bạn có chắc chắn muốn xóa vĩnh viễn danh mục này?
            </div>

            using (Html.BeginForm("Xoa", "DanhMuc", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.CategoryID">

                <div style="display: flex; gap: 12px; align-items: center;">
                    <button type="submit" style="flex: 1; display: inline-flex; align-items: center; justify-content: center; padding: 12px 20px; background: #dc2626; color: #fff; border: none; border-radius: 12px; font-size: 15px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);">Xác nhận xóa</button>
                    <a href="/DanhMuc" style="flex: 1; display: inline-flex; align-items: center; justify-content: center; padding: 12px 20px; background: #f1f5f9; color: #334155; border-radius: 12px; font-size: 15px; font-weight: 600; text-decoration: none;">Hủy bỏ</a>
                </div>
            }
        }

    </div>
</div>