@model ELLA_Store.Models.PagedProductsViewModel
@* Partial dùng chung cho các trang theo hãng: thanh tìm kiếm/lọc/sắp xếp + lưới sản phẩm + phân trang. *@

<form method="get" action="@Url.Action(Model.ActionName, "Home")" class="store-filter">
    <input type="text" name="keyword" value="@Model.SearchTerm" placeholder="Tìm theo tên giày...">
    <input type="number" name="minPrice" value="@Model.MinPrice" placeholder="Giá từ" min="0">
    <input type="number" name="maxPrice" value="@Model.MaxPrice" placeholder="Giá đến" min="0">
    <select name="sortOrder">
        <option value="" @(string.IsNullOrEmpty(Model.SortOrder) ? "selected" : "")>Mặc định</option>
        <option value="price_asc" @(Model.SortOrder == "price_asc" ? "selected" : "")>Giá tăng dần</option>
        <option value="price_desc" @(Model.SortOrder == "price_desc" ? "selected" : "")>Giá giảm dần</option>
        <option value="name" @(Model.SortOrder == "name" ? "selected" : "")>Tên A-Z</option>
    </select>
    <button type="submit" class="btn">Lọc</button>
</form>

<div class="product-grid">
    @foreach (var p in Model.Items)
    {
        <a href="/Home/Chitietsanpham?id=@p.ProductID" class="product-item">
            <img src="@Url.Content("~/Content/image/" + p.ImagePro)" alt="@p.NamePro">
            <h3>@p.NamePro</h3>
            <p class="price">@p.Price.ToString("#,##0")đ</p>
        </a>
    }
</div>

@if (Model.Items.Count == 0)
{
    <p style="text-align:center;color:#64748b;">Không tìm thấy sản phẩm phù hợp.</p>
}

@* ==================== PHÂN TRANG ==================== *@
@if (Model.TotalPages > 1)
{
    <div class="store-pagination">

        @* Nút quay về trang trước *@
        @if (Model.CurrentPage > 1)
        {
            <a href="@Url.Action(Model.ActionName, "Home", new
                {
                    keyword = Model.SearchTerm,
                    minPrice = Model.MinPrice,
                    maxPrice = Model.MaxPrice,
                    sortOrder = Model.SortOrder,
                    page = Model.CurrentPage - 1
                })">&larr; Trước</a>
        }

        @* Hiển thị các số trang: luôn có trang đầu, trang cuối và 2 trang quanh trang hiện tại; phần còn lại thu gọn thành "…" *@
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            if (i != 1 && i != Model.TotalPages && System.Math.Abs(i - Model.CurrentPage) > 2)
            {
                if (System.Math.Abs(i - Model.CurrentPage) == 3)
                {
                    <span class="dots">&hellip;</span>
                }
                continue;
            }
            if (i == Model.CurrentPage)
            {
                @* Trang hiện tại không cần tạo link *@
                <span class="active">@i</span>
            }
            else
            {
                <a href="@Url.Action(Model.ActionName, "Home", new
                    {
                        keyword = Model.SearchTerm,
                        minPrice = Model.MinPrice,
                        maxPrice = Model.MaxPrice,
                        sortOrder = Model.SortOrder,
                        page = i
                    })">@i</a>
                }
            }

        @* Nút sang trang kế tiếp *@
        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a href="@Url.Action(Model.ActionName, "Home", new
                {
                    keyword = Model.SearchTerm,
                    minPrice = Model.MinPrice,
                    maxPrice = Model.MaxPrice,
                    sortOrder = Model.SortOrder,
                    page = Model.CurrentPage + 1
                })">Sau &rarr;</a>
        }
    </div>
}

<style>
    .store-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 20px;
    }

        .store-filter input, .store-filter select {
            padding: 9px 12px;
            border: 1px solid var(--line, #d7e3e1);
            border-radius: 10px;
            font: inherit;
            background: #fff;
        }

            .store-filter input[type=text] {
                flex: 1;
                min-width: 180px;
            }

            .store-filter input[type=number] {
                width: 120px;
            }

        .store-filter .btn {
            border: 0;
            cursor: pointer;
        }

    .store-pagination {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
        margin: 10px 0 30px;
    }

        .store-pagination a, .store-pagination span {
            min-width: 40px;
            padding: 9px 14px;
            text-align: center;
            border: 1px solid #808080;
            border-radius: 10px;
            background: #fff;
            color: inherit;
            text-decoration: none;
            font-weight: 600;
        }

            .store-pagination a:hover {
                border-color: #1e2235;
                color: grey;
            }

            .store-pagination span.dots {
                border: 0;
                background: transparent;
                min-width: 0;
                padding: 9px 4px;
            }

            .store-pagination span.active {
                background: #1e2235;
                border-color: #1e2235;
                color: #fff;
            }
</style>
