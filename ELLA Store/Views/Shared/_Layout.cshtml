@* Layout dùng chung cho toàn bộ ELLA Store: topbar + header + aside danh mục + nội dung + footer. *@
@{
    var action = (ViewContext.RouteData.Values["action"] ?? "Index").ToString().ToLower();
    Func<string, string> act = (name) => action == name.ToLower() ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - ELLA Store</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/style.css")" rel="stylesheet" />
    <style>
        /* Luôn hiện tên từng mục của form; ô chọn tròn/vuông giữ kích thước nhỏ */
        .form-group label {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            color: #334155 !important;
            font-size: 13px !important;
            font-weight: 700 !important;
            height: auto !important;
        }

        .form-group input[type=radio], .form-group input[type=checkbox] {
            width: auto !important;
            height: auto !important;
            padding: 0 !important;
            margin: 0 8px 0 0 !important;
            display: inline-block !important;
            border-radius: 0 !important;
        }

        .form-control::placeholder, .form-group input::placeholder {
            color: #94a3b8;
            opacity: 1;
        }
    </style>
</head>
<body>

    <header class="store-header">
        <div class="container header-inner">
            <a class="brand" href="/Home/Index">ELLA<span>STORE</span></a>

            <!-- Menu hãng giày -->
            <nav class="main-menu">
                <a href="/Home/Index" class="@act("Index")">Trang chủ</a>
                <a href="/Home/Nike" class="@act("Nike")">Nike</a>
                <a href="/Home/Adidas" class="@act("Adidas")">Adidas</a>
                <a href="/Home/Biti" class="@act("Biti")">Biti's</a>
                <a href="/Home/Asics" class="@act("Asics")">Asics</a>
                <a href="/Home/Puma" class="@act("Puma")">Puma</a>
            </nav>

            <div class="header-right">
                <!-- Thanh tìm kiếm -->
                <form class="search-box" method="get" action="/Home/TimKiem">
                    <input type="text" id="timKiem" name="keyword" value="@Request.QueryString["keyword"]" placeholder="Tìm kiếm sản phẩm...">
                    <button type="submit">Tìm</button>
                </form>

                <!-- Tài khoản -->
                @if (Session["UserID"] != null)
                {
                    <details class="acc-menu">
                        <summary>@Session["FullName"]</summary>
                        <div class="acc-pop">
                            <a href="/Home/TaiKhoan">Tài khoản của tôi</a>
                            <a href="/Home/Lichsumuahang">Lịch sử mua hàng</a>
                            <a href="/Home/DoiMatKhau">Đổi mật khẩu</a>
                            @if ((string)Session["Role"] == "Admin")
                            {
                                <a href="/Admin/SanPham">Trang quản trị</a>
                            }
                            <a href="/Home/DangXuat">Đăng xuất</a>
                        </div>
                    </details>
                }
                else
                {
                    <a class="acc-link" href="/Home/Dangnhap">Đăng nhập</a>
                    <a class="acc-link" href="/Home/Dangky">Đăng ký</a>
                }

                <a href="/Home/Giohang" class="cart">
                    <img src="~/Content/image/cart.jpg" class="cart-icon" alt="Giỏ hàng">
                    <span class="cart-count" id="cartCount"></span>
                </a>
            </div>
        </div>
    </header>

    <div class="container main-content">
        <div class="store-shell">
            <!-- NỘI DUNG TỪNG TRANG -->
            <section class="store-content">
                @RenderBody()
            </section>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="store-footer">
        <div class="container footer-content">
            <div class="footer-section">
                <h3>VỀ ELLA STORE</h3>
                <p>Hệ thống thời trang giày dép uy tín, chất lượng hàng đầu.</p>
                <p>Địa chỉ: 123 Đường ABC, TP.HCM</p>
                <p>Hotline: 0123 456 789</p>
            </div>
            <div class="footer-section">
                <h3>HỖ TRỢ KHÁCH HÀNG</h3>
                <p><a href="#">Hướng dẫn mua hàng</a></p>
                <p><a href="#">Chính sách đổi trả</a></p>
                <p><a href="#">Chính sách bảo mật</a></p>
                <p><a href="#">Phương thức thanh toán</a></p>
            </div>
            <div class="footer-section">
                <h3>CHÍNH SÁCH</h3>
                <p><a href="#">Chính sách vận chuyển</a></p>
                <p><a href="#">Chính sách kiểm hàng</a></p>
                <p><a href="#">Quy định chung</a></p>
            </div>
            <div class="footer-section">
                <h3>KẾT NỐI VỚI CHÚNG TÔI</h3>
                <p><a href="#">Facebook</a> | <a href="#">Instagram</a></p>
                <p><a href="#">TikTok</a> | <a href="#">Shopee</a></p>
                <h3 class="footer-sub">ĐĂNG KÝ NHẬN TIN</h3>
                <p class="footer-muted">Nhận mã giảm giá và sản phẩm mới sớm nhất.</p>
            </div>
        </div>
        <div class="container footer-copy">&copy; 2026 ELLA Store. All rights reserved.</div>
    </footer>

    <script>
        /* SỐ LƯỢNG TRÊN BIỂU TƯỢNG GIỎ HÀNG */
        try {
            var gio = JSON.parse(localStorage.getItem("cart")) || [];
            var tong = gio.reduce(function (s, sp) { return s + (Number(sp.quantity) || 0); }, 0);
            if (tong > 0) document.getElementById("cartCount").innerText = tong;
        } catch (e) { }
    </script>
</body>
</html>
