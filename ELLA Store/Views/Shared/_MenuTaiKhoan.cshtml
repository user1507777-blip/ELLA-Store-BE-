@* Thanh chuyển tab của khu vực "Tài khoản của tôi". Truyền tab hiện tại qua ViewBag.TabTaiKhoan *@
@{
    string tab = ViewBag.TabTaiKhoan as string;
}
<div class="acc-tabs">
    <a href="/Home/TaiKhoan" class="@(tab == "thongtin" ? "on" : "")">Thông tin cá nhân</a>
    <a href="/Home/LichSuMuaHang" class="@(tab == "donhang" ? "on" : "")">Đơn hàng của tôi</a>
    <a href="/Home/DoiMatKhau" class="@(tab == "matkhau" ? "on" : "")">Đổi mật khẩu</a>
</div>
<style>
    .acc-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 22px; }
    .acc-tabs a { padding: 9px 18px; border: 1px solid var(--line, #d7e3e1); border-radius: 999px; background: #fff; color: inherit; text-decoration: none; font-weight: 600; font-size: 14px; }
    .acc-tabs a.on { background: var(--brand, #0f766e); border-color: var(--brand, #0f766e); color: #fff; }
    .acc-stats { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 22px; }
    .acc-stats div { flex: 1; min-width: 140px; background: #fff; border: 1px solid var(--line, #d7e3e1); border-radius: 14px; padding: 14px 16px; }
    .acc-stats b { display: block; font-size: 20px; color: var(--brand-dark, #0f766e); }
    .acc-stats span { font-size: 13px; color: #64748b; }
    .tt-badge { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; background: #e2e8f0; color: #334155; }
    .tt-badge.ok { background: #dcfce7; color: #166534; }
    .tt-badge.wait { background: #fef3c7; color: #92400e; }
    .tt-badge.ship { background: #dbeafe; color: #1e40af; }
    .tt-badge.bad { background: #fee2e2; color: #991b1b; }
</style>
