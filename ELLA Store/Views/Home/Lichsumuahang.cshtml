@model System.Collections.Generic.List<ELLA_Store.Models.Order>
@using ELLA_Store.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Đơn hàng của tôi";
    ViewBag.TabTaiKhoan = "donhang";
}

<main class="order-detail-container">
    @Html.Partial("_MenuTaiKhoan")
    <h2>ĐƠN HÀNG CỦA TÔI</h2>

    @if (Model.Count == 0)
    {
        <p style="color:#64748b;">Bạn chưa có đơn hàng nào. <a href="/Home/Index">Mua sắm ngay</a></p>
    }
    else
    {
        <table class="order-table">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Sản phẩm</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Thanh toán</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td>#@o.OrderID</td>
                        <td>@string.Join(", ", o.Items.Select(i => i.ProductName + " x" + i.Quantity))</td>
                        <td>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@o.TotalPrice.ToString("#,##0")đ</td>
                        <td><span class="tt-badge @TtLop(o.Status)">@o.Status</span></td>
                        <td>@o.PaymentStatus</td>
                        <td><a href="/Home/ChiTietMuaHang/@o.OrderID">Xem chi tiết</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</main>

@functions {
    public static string TtLop(string st)
    {
        if (st == OrderStatus.HoanThanh) return "ok";
        if (st == OrderStatus.DaHuy) return "bad";
        if (st == OrderStatus.DangGiao) return "ship";
        return "wait";
    }
}
