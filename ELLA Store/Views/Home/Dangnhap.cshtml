@model ELLA_Store.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Đăng nhập";
}

<div class="container-custom">

    <div class="auth-wrapper">

        <!-- KHỐI FORM ĐĂNG NHẬP -->
        <div class="auth-box">
            <h2>Đăng Nhập</h2>

            @if (TempData["ThongBao"] != null)
            {
                <p class="success-msg">@TempData["ThongBao"]</p>
            }

            @using (Html.BeginForm("DangNhap", "Home", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "error-msg" })

                <div class="form-group">
                    <label>Tên đăng nhập *</label>
                    <input type="text" name="Username" value="@Model.Username" class="form-control" required>
                    <span class="error-msg">@Html.ValidationMessage("Username")</span>
                </div>

                <div class="form-group">
                    <label>Mật khẩu *</label>
                    <input type="password" name="Password" class="form-control" required>
                    <span class="error-msg">@Html.ValidationMessage("Password")</span>
                </div>

                <button type="submit" class="btn">
                    Đăng nhập
                </button>
            }

            <p>
                Chưa có tài khoản?
                <a href="/Home/Dangky">Đăng ký ngay</a>
            </p>

        </div>

    </div>

</div>
