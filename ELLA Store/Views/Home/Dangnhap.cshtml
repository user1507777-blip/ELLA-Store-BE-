@model ELLA_Store.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Đăng nhập";
}

<style>
    .login-page { display: flex; justify-content: center; padding: 12px 0 24px; }
    .login-card { display: grid; grid-template-columns: 1fr 1fr; width: 100%; max-width: 920px; min-height: 480px; background: #fff; border: 1px solid #e5e7eb; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 50px rgba(17,24,39,.08); }
    .login-side { position: relative; display: flex; flex-direction: column; justify-content: flex-end; padding: 36px; color: #fff; background: #111827 url('@Url.Content("~/Content/image/banner2.jpeg")') center / cover no-repeat; }
    .login-side::before { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(17,24,39,.88), rgba(17,24,39,.25)); }
    .login-side > * { position: relative; }
    .login-side .tag { font-size: 12px; font-weight: 700; letter-spacing: 4px; color: #d1d5db; margin-bottom: 10px; }
    .login-side h3 { margin: 0 0 10px; font-size: 28px; line-height: 1.2; font-weight: 800; }
    .login-side p { margin: 0; font-size: 14px; line-height: 1.6; color: #e5e7eb; }

    .login-form { padding: 48px 44px; display: flex; flex-direction: column; justify-content: center; }
    .login-form h2 { margin: 0 0 6px; font-size: 26px; font-weight: 800; }
    .login-form .sub { margin: 0 0 26px; font-size: 14px; color: #6b7280; }
    .login-form .lb { display: block; font-size: 13px; font-weight: 600; color: #111827; margin: 0 0 6px; }
    .login-form .field { margin-bottom: 18px; }
    .login-form input[type=text], .login-form input[type=password] { width: 100%; height: 46px; padding: 0 14px; border: 1px solid #d1d5db; border-radius: 10px; background: #fff; font: inherit; font-size: 14px; transition: border-color .2s, box-shadow .2s; }
    .login-form input:focus { outline: none; border-color: #111827; box-shadow: 0 0 0 3px rgba(17,24,39,.1); }
    .pw-wrap { position: relative; }
    .pw-wrap input { padding-right: 70px !important; }
    .pw-toggle { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); border: 0; background: transparent; color: #6b7280; font-size: 13px; font-weight: 600; cursor: pointer; padding: 6px 8px; }
    .pw-toggle:hover { color: #111827; }
    .login-btn { width: 100%; height: 46px; border: 0; border-radius: 10px; background: #111827; color: #fff; font: inherit; font-size: 15px; font-weight: 700; cursor: pointer; transition: background .2s; margin-top: 4px; }
    .login-btn:hover { background: #dc2626; }
    .login-foot { margin: 22px 0 0; text-align: center; font-size: 14px; color: #6b7280; }
    .login-foot a { color: #111827; font-weight: 700; text-decoration: none; border-bottom: 1px solid #111827; }
    .login-foot a:hover { color: #dc2626; border-color: #dc2626; }
    .login-ok { margin: 0 0 16px; padding: 10px 14px; border-radius: 10px; background: #f0fdf4; color: #166534; font-size: 14px; }
    .login-err { margin: 0 0 14px; padding: 10px 14px; border-radius: 10px; background: #fef2f2; color: #b91c1c; font-size: 14px; }
    .login-err:empty, .login-err ul:empty { display: none; }
    @@media (max-width: 760px) {
        .login-card { grid-template-columns: 1fr; }
        .login-side { display: none; }
        .login-form { padding: 32px 24px; }
    }
</style>

<div class="login-page">
    <div class="login-card">

        <!-- CỘT ẢNH -->
        <div class="login-side">
            <span class="tag">ELLA STORE</span>
            <h3>Chào mừng trở lại</h3>
            <p>Đăng nhập để theo dõi đơn hàng, lưu thông tin nhận hàng và nhận ưu đãi mới nhất.</p>
        </div>

        <!-- CỘT FORM -->
        <div class="login-form">
            <h2>Đăng nhập</h2>
            <p class="sub">Nhập tài khoản của bạn để tiếp tục mua sắm.</p>

            @if (TempData["ThongBao"] != null)
            {
                <div class="login-ok">@TempData["ThongBao"]</div>
            }

            @using (Html.BeginForm("DangNhap", "Home", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="login-err">@Html.ValidationSummary(true)</div>

                <div class="field">
                    <label class="lb" for="Username" style="display:block;visibility:visible;opacity:1;color:#111827;text-transform:none;letter-spacing:0;">Tên đăng nhập</label>
                    <input type="text" id="Username" name="Username" value="@Model.Username" placeholder="Nhập tên đăng nhập" autocomplete="username" required>
                    <span class="error-msg">@Html.ValidationMessage("Username")</span>
                </div>

                <div class="field">
                    <label class="lb" for="Password" style="display:block;visibility:visible;opacity:1;color:#111827;text-transform:none;letter-spacing:0;">Mật khẩu</label>
                    <div class="pw-wrap">
                        <input type="password" id="Password" name="Password" placeholder="Nhập mật khẩu" autocomplete="current-password" required>
                        <button type="button" class="pw-toggle" id="pwToggle">Hiện</button>
                    </div>
                    <span class="error-msg">@Html.ValidationMessage("Password")</span>
                </div>

                <button type="submit" class="login-btn">Đăng nhập</button>
            }

            <p class="login-foot">Chưa có tài khoản? <a href="/Home/Dangky">Đăng ký ngay</a></p>
        </div>

    </div>
</div>

<script>
    // Hiện / ẩn mật khẩu
    (function () {
        var b = document.getElementById("pwToggle"), i = document.getElementById("Password");
        if (!b || !i) return;
        b.onclick = function () {
            var an = i.type === "password";
            i.type = an ? "text" : "password";
            b.innerText = an ? "Ẩn" : "Hiện";
        };
    })();
</script>
