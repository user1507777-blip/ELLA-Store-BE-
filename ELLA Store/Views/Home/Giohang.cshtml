@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Giỏ hàng";
}

<div class="container-custom" style="padding-top: 30px;">
    <h2>Giỏ Hàng Của Bạn</h2>

    <p id="thongBaoGio" style="color:#b91c1c;font-weight:600;min-height:20px;"></p>

    <table class="cart-table" style="margin-top: 20px;">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Size</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Tổng cộng</th>
                <th>Xóa</th>
            </tr>
        </thead>
        <tbody id="gioHang"></tbody>
    </table>

    <div class="cart-summary">
        <div class="summary-box">
            <div class="summary-row">
                <span>Thành tiền:</span>
                <span style="font-size: 20px; color: red;"><span id="thanhTien">0</span>đ</span>
            </div>
            <p style="font-size:13px;color:#64748b;margin:8px 0;">Miễn phí vận chuyển cho đơn từ 1.000.000đ, dưới mức đó phí 30.000đ.</p>

            <!-- Sang trang đặt hàng (phải đăng nhập, chưa đăng nhập sẽ được chuyển sang trang Đăng nhập) -->
            <a href="/Home/Dathang" class="btn" style="display: block; text-align: center;">Thanh toán</a>
        </div>
    </div>
</div>

<script>
    function layGio() {
        try { return JSON.parse(localStorage.getItem("cart")) || []; } catch (e) { return []; }
    }
    function luuGio(g) {
        localStorage.setItem("cart", JSON.stringify(g));
    }

    // Vẽ lại toàn bộ giỏ hàng và tổng tiền
    function hienThiGioHang() {
        var gioHang = layGio();
        var ds = document.getElementById("gioHang");
        ds.innerHTML = "";
        var tongTien = 0;

        if (gioHang.length === 0) {
            ds.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:24px;">Giỏ hàng đang trống. <a href="/Home/Index">Tiếp tục mua sắm</a></td></tr>';
        }

        gioHang.forEach(function (sp, index) {
            var tong = sp.price * sp.quantity;
            tongTien += tong;
            var max = sp.max ? sp.max : "";
            var dong = document.createElement("tr");
            dong.innerHTML =
                '<td><div class="cart-item-info"><img src="' + sp.image + '" alt=""><div><strong>' + sp.name + '</strong></div></div></td>' +
                '<td>' + sp.size + '</td>' +
                '<td>' + sp.price.toLocaleString("vi-VN") + 'đ</td>' +
                '<td><input type="number" value="' + sp.quantity + '" min="1" ' + (max ? 'max="' + max + '"' : '') + ' class="quantity-input" onchange="doiSoLuong(' + index + ', this.value)">' +
                (max ? '<div style="font-size:12px;color:#64748b;">Còn ' + max + '</div>' : '') + '</td>' +
                '<td>' + tong.toLocaleString("vi-VN") + 'đ</td>' +
                '<td><button onclick="xoaSanPham(' + index + ')">Xóa</button></td>';
            ds.appendChild(dong);
        });

        document.getElementById("thanhTien").innerText = tongTien.toLocaleString("vi-VN");
        localStorage.setItem("cartTotal", tongTien);
    }

    // Đổi số lượng: không vượt quá tồn kho của size đó
    function doiSoLuong(index, soLuongMoi) {
        var gioHang = layGio();
        var tb = document.getElementById("thongBaoGio");
        tb.innerText = "";
        soLuongMoi = parseInt(soLuongMoi, 10);
        if (isNaN(soLuongMoi) || soLuongMoi < 1) soLuongMoi = 1;
        var max = gioHang[index].max;
        if (max && soLuongMoi > max) {
            soLuongMoi = max;
            tb.innerText = "Size " + gioHang[index].size + " của \"" + gioHang[index].name + "\" chỉ còn " + max + " sản phẩm.";
        }
        gioHang[index].quantity = soLuongMoi;
        luuGio(gioHang);
        hienThiGioHang();
    }

    function xoaSanPham(index) {
        var gioHang = layGio();
        gioHang.splice(index, 1);
        luuGio(gioHang);
        hienThiGioHang();
    }

    hienThiGioHang();
</script>
