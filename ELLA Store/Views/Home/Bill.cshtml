@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Hóa đơn";
}

<div id="bill">
    <h1>ELLA STORE</h1>
    <h2>HÓA ĐƠN ĐẶT HÀNG</h2>

    <!-- Mã đơn hàng -->
    <p>
        <strong>Mã đơn hàng:</strong>
        <span id="billMaDon"></span>
    </p>

    <!-- Ngày đặt -->
    <p>
        <strong>Ngày đặt:</strong>
        <span id="billNgayDat"></span>
    </p>

    <hr>

    <!-- Thông tin khách hàng -->
    <h3>Thông tin khách hàng</h3>

    <p>
        <strong>Họ tên:</strong>
        <span id="billHoTen"></span>
    </p>

    <p>
        <strong>Số điện thoại:</strong>
        <span id="billSoDienThoai"></span>
    </p>

    <p>
        <strong>Email:</strong>
        <span id="billEmail"></span>
    </p>

    <p>
        <strong>Địa chỉ:</strong>
        <span id="billDiaChi"></span>
    </p>

    <!-- Danh sách sản phẩm -->
    <h3>Sản phẩm</h3>

    <table class="bill-table">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Size</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>

        <tbody id="billSanPham">
            <!-- JavaScript tự đưa sản phẩm vào đây -->
        </tbody>
    </table>

    <!-- Tổng tiền -->
    <div class="bill-total">
        <strong>TỔNG TIỀN:</strong>
        <span id="billTongTien">0</span> VNĐ
    </div>

    <p>
        <strong>Phương thức thanh toán:</strong>
        <span id="billThanhToan"></span> (<span id="billTinhTrang"></span>)
    </p>
    <p><a href="/Home/LichSuMuaHang">Xem đơn hàng của tôi</a></p>

    <!-- Nút in -->
    <button onclick="inBill()">
        IN BILL
    </button>
</div>

<script>
    function fmt(n) { return Number(n || 0).toLocaleString("vi-VN"); }

    // Hóa đơn lấy từ đơn hàng vừa được lưu vào database (do trang Đặt hàng lưu lại)
    function taoBill() {
        var o = null;
        try { o = JSON.parse(localStorage.getItem("lastOrder")); } catch (e) { }
        if (!o) {
            document.getElementById("bill").innerHTML = "<p>Chưa có đơn hàng nào. <a href='/Home/Index'>Về trang chủ</a></p>";
            return;
        }
        document.getElementById("billMaDon").innerText = "#" + o.id;
        document.getElementById("billNgayDat").innerText = o.date;
        document.getElementById("billHoTen").innerText = o.receiver || "—";
        document.getElementById("billSoDienThoai").innerText = o.phone || "—";
        document.getElementById("billEmail").innerText = o.email || "—";
        document.getElementById("billDiaChi").innerText = o.address || "—";
        document.getElementById("billSanPham").innerHTML = o.items.map(function (i) {
            return "<tr><td>" + i.name + "</td><td>" + (i.size || "") + "</td><td>" + i.quantity + "</td><td>" +
                fmt(i.price) + "đ</td><td>" + fmt(i.price * i.quantity) + "đ</td></tr>";
        }).join("") +
            "<tr><td colspan='4'>Phí vận chuyển</td><td>" + fmt(o.shipping) + "đ</td></tr>";
        document.getElementById("billTongTien").innerText = fmt(o.total);
        document.getElementById("billThanhToan").innerText = o.paymentMethod === "COD" ? "Thanh toán khi nhận hàng" : "Chuyển khoản";
        document.getElementById("billTinhTrang").innerText = o.paymentStatus;
    }

    function inBill() { window.print(); }
    taoBill();
</script>
