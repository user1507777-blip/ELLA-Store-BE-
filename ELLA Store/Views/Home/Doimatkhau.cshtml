@model ELLA_Store.Models.ChangePasswordViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Đổi mật khẩu";
    ViewBag.TabTaiKhoan = "matkhau";
}

<div class="container-custom">
    @Html.Partial("_MenuTaiKhoan")
    <div class="auth-wrapper">
        <div class="auth-box">
            <h2>Đổi Mật Khẩu</h2>

            @if (ViewBag.ThongBao != null)
            {
                <p class="success-msg">@ViewBag.ThongBao</p>
            }

            @using (Html.BeginForm("DoiMatKhau", "Home", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <div class="fl-nhan" style="display:block;font-size:13px;font-weight:700;color:#334155;margin:0 0 4px;visibility:visible;opacity:1;">Mật khẩu hiện tại *</div>
                    <input type="password" name="OldPassword" class="form-control">
                    <span class="error-msg">@Html.ValidationMessage("OldPassword")</span>
                </div>

                <div class="form-group">
                    <div class="fl-nhan" style="display:block;font-size:13px;font-weight:700;color:#334155;margin:0 0 4px;visibility:visible;opacity:1;">Mật khẩu mới *</div>
                    <input type="password" name="NewPassword" class="form-control">
                    <span class="error-msg">@Html.ValidationMessage("NewPassword")</span>
                </div>

                <div class="form-group">
                    <div class="fl-nhan" style="display:block;font-size:13px;font-weight:700;color:#334155;margin:0 0 4px;visibility:visible;opacity:1;">Xác nhận mật khẩu mới *</div>
                    <input type="password" name="ConfirmPassword" class="form-control">
                    <span class="error-msg">@Html.ValidationMessage("ConfirmPassword")</span>
                </div>

                <button type="submit" class="btn">Đổi mật khẩu</button>
            }

        </div>
    </div>
</div>
