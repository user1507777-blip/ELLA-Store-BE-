@model List<ELLA_Store.Models.Product>
<table class="order-table">
    <thead>
        <tr><th>ID</th><th>Ảnh</th><th>Tên sản phẩm</th><th>Danh mục</th><th>Tồn theo size</th><th>Tổng</th></tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.ProductID</td>
                <td><img class="admin-thumb" src="@Url.Content("~/Content/image/" + p.ImagePro)" alt="@p.NamePro"></td>
                <td>@p.NamePro</td>
                <td>@p.CategoryName</td>
                <td>
                    @foreach (var sz in p.Sizes)
                    {
                        <span class="st @(sz.Quantity == 0 ? "st-huy" : sz.Quantity < 3 ? "st-cho" : "st-xong")" style="margin:0 4px 4px 0;display:inline-block;">@sz.Size: @sz.Quantity</span>
                    }
                    @if (p.Sizes.Count == 0) { <em>Chưa có size</em> }
                </td>
                <td>
                    @if (p.Stock < 5)
                    { <span class="st st-cho">@p.Stock (sắp hết)</span> }
                    else
                    { <span class="st st-xong">@p.Stock</span> }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="6" style="text-align:center;">Không có hàng tồn.</td></tr>
        }
    </tbody>
</table>
