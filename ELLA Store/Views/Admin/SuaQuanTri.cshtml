@model ELLA_Store.Models.AdminEditViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Sửa quản trị viên";
}

<div class="container-custom">
    <div class="auth-wrapper">
        <div class="auth-box">
            <h2>Sửa quản trị viên</h2>

            @using (Html.BeginForm("SuaQuanTri", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="Username" value="@Model.Username">

                <div class="form-group">
                    <label>Tên đăng nhập</label>
                    <input type="text" value="@Model.Username" class="form-control" disabled>
                </div>
                <div class="form-group">
                    <label>Họ và tên *</label>
                    <input type="text" name="FullName" value="@Model.FullName" class="form-control">
                    <span class="error-msg">@Html.ValidationMessage("FullName")</span>
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="text" name="Email" value="@Model.Email" class="form-control">
                    <span class="error-msg">@Html.ValidationMessage("Email")</span>
                </div>
                <div class="form-group">
                    <label>Số điện thoại</label>
                    <input type="text" name="Phone" value="@Model.Phone" class="form-control">
                    <span class="error-msg">@Html.ValidationMessage("Phone")</span>
                </div>
                <div class="form-group">
                    <label>Mật khẩu mới (để trống nếu không đổi)</label>
                    <input type="password" name="NewPassword" class="form-control">
                    <span class="error-msg">@Html.ValidationMessage("NewPassword")</span>
                </div>
                <div class="form-group">
                    <label><input type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "")> Đang hoạt động</label>
                    <input type="hidden" name="IsActive" value="false">
                    <span class="error-msg">@Html.ValidationMessage("IsActive")</span>
                </div>

                <button type="submit" class="btn">Lưu thay đổi</button>
            }
            <p><a href="/Admin/NguoiDung">&larr; Quay lại danh sách</a></p>
        </div>
    </div>
</div>
