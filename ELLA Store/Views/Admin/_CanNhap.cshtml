@model List<ELLA_Store.Models.Product>
<table class="order-table">
    <thead>
        <tr><th>ID</th><th>Ảnh</th><th>Tên sản phẩm</th><th>Danh mục</th><th>Tồn kho</th></tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.ProductID</td>
                <td><img class="admin-thumb" src="@Url.Content("~/Content/image/" + p.ImagePro)" alt="@p.NamePro"></td>
                <td>@p.NamePro</td>
                <td>@p.CategoryName</td>
                <td><span class="st st-huy">Hết hàng</span></td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" style="text-align:center;">Không có mặt hàng nào cần nhập.</td></tr>
        }
    </tbody>
</table>
