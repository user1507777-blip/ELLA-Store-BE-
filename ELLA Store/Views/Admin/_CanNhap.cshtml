@model List<ELLA_Store.Models.Product>
<table class="order-table">
    <thead>
        <tr><th>ID</th><th>Ảnh</th><th>Tên sản phẩm</th><th>Danh mục</th><th>Tồn kho</th><th>Nhập kho</th></tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.ProductID</td>
                <td><img class="admin-thumb" src="@Url.Content("~/Content/image/" + p.ImagePro)" alt="@p.NamePro"></td>
                <td>@p.NamePro</td>
                <td>@p.CategoryName</td>
                <td><span class="st st-huy">Hết hàng</span></td>
                <td>
                    <form method="post" action="/Admin/DieuChinhKho" class="admin-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@p.ProductID">
                        <input type="number" name="soLuong" min="1" required class="quantity-input" placeholder="Số lượng nhập">
                        <button type="submit">Nhập kho</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="6" style="text-align:center;">Không có mặt hàng nào cần nhập.</td></tr>
        }
    </tbody>
</table>
