@model IEnumerable<ELLA_Store.Models.Product>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Quản lý hàng hóa";
}

<div class="container-custom">
    <h2>Quản Lý Hàng Hóa</h2>
    @if (TempData["ThongBao"] != null)
    {<p class="success-msg">@TempData["ThongBao"]</p>}
    @if (TempData["Loi"] != null)
    {<p class="error-msg">@TempData["Loi"]</p>}

    <form method="get" action="/HangHoa" class="admin-toolbar">
        <input type="text" name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm theo tên hàng hóa...">
        <select name="danhMuc" class="form-control" style="max-width:200px;">
            <option value="">Tất cả danh mục</option>
            @foreach (var c in (IEnumerable<ELLA_Store.Models.Category>)ViewBag.DanhMucs)
            {
                <option value="@c.CategoryID" @(ViewBag.DanhMuc == c.CategoryID ? "selected" : "")>@c.CategoryName</option>
            }
        </select>
        <button type="submit" class="btn">Lọc</button>
        <a href="/HangHoa/Them" class="btn">+ Thêm hàng hóa</a>
    </form>

    <table class="order-table">
        <thead>
            <tr>
                <th>Ảnh</th>
                <th>Tên hàng hóa</th>
                <th>Danh mục</th>
                <th>Giá</th>
                <th>Tồn kho</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><img class="admin-thumb" src="@Url.Content("~/Content/image/" + p.ImagePro)" alt="@p.NamePro"></td>
                    <td>@p.NamePro</td>
                    <td>@p.CategoryName</td>
                    <td>@p.Price.ToString("#,##0")đ</td>
                    <td>@p.Stock</td>
                    <td>
                        <a href="/HangHoa/ChiTiet/@p.ProductID">Chi tiết</a>
                        | <a href="/HangHoa/Sua/@p.ProductID">Sửa</a>
                        | <a href="/HangHoa/Xoa/@p.ProductID" style="color:#b91c1c;">Xóa</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" style="text-align:center;">Không có hàng hóa nào.</td></tr>
            }
        </tbody>
    </table>
    <p style="color:#64748b;">Nhập/xuất tồn kho thực hiện ở <a href="/Admin/SanPham">Quản lý kho hàng</a>.</p>
</div>

